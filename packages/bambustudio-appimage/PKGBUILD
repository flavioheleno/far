# Maintainer: Flavio Heleno <flaviohbatista@gmail.com>
# Contributor: Joao Costa <arch@joaocosta.dev>
# Based on AUR bambustudio-appimage; see README.md for provenance.
pkgname=bambustudio-appimage
pkgver='2.9.1.70'
pkgrel='1'
pkgdesc='PC software for Bambu Lab and other 3D printers'
arch=('x86_64')
url='https://github.com/bambulab/BambuStudio'
license=('AGPL-3.0')
depends=('webkit2gtk-4.1')
provides=('bambustudio')
conflicts=('bambustudio' 'bambustudio-git' 'bambustudio-bin')
options=('!strip' '!debug')

_url='https://github.com/bambulab/BambuStudio/releases/download/v02.09.01.70/BambuStudio_ubu24-v02.09.01.70-20261103183404.AppImage'
source=("BambuStudio-${pkgver}.AppImage::${_url}")
sha256sums=('668dabb1be53c758189ed6bc89935285dea5e0af46216546b1bafd6882e9aff0')

prepare() {
  chmod +x "BambuStudio-${pkgver}.AppImage"
  ./"BambuStudio-${pkgver}.AppImage" --appimage-extract > /dev/null
}

package() {
  install -Dm755 "BambuStudio-${pkgver}.AppImage" "$pkgdir/usr/bin/bambustudio"
  install -Dm644 squashfs-root/BambuStudio.png \
    "$pkgdir/usr/share/pixmaps/BambuStudio.png"

  sed 's|^Exec=AppRun|Exec=/usr/bin/bambustudio|' \
    squashfs-root/BambuStudio.desktop > BambuStudio.desktop
  install -Dm644 BambuStudio.desktop \
    "$pkgdir/usr/share/applications/BambuStudio.desktop"
}
