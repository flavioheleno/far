pkgname=tailwindcss-bin
pkgver=4.3.3
pkgrel=1
pkgdesc='Standalone Tailwind CLI without dependency on Node.js'
arch=('aarch64' 'x86_64')
url='https://tailwindcss.com'
license=('MIT')
depends=('glibc')
options=('!strip')
conflicts=('tailwindcss')
provides=('tailwindcss')

_url_license='https://github.com/tailwindlabs/tailwindcss/raw/v4.3.3/LICENSE'
_url_aarch64='https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.3/tailwindcss-linux-arm64'
_url_x86_64='https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.3/tailwindcss-linux-x64'

source_aarch64=("tailwindcss-${pkgver}-aarch64::${_url_aarch64}")
source_x86_64=("tailwindcss-${pkgver}-x86_64::${_url_x86_64}")

source=("LICENSE-${pkgver}::${_url_license}")

sha256sums=('60e0b68c0f35c078eef3a5d29419d0b03ff84ec1df9c3f9d6e39a519a5ae7985')
sha256sums_aarch64=('55fd0b241214eff3de1e8ee4f22796662f2d2e7a49bcfca7477cfd0bac398195')
sha256sums_x86_64=('dc61b3ac6b8c9ca874c0cc4c57b2409791a64c5540404ca5f5367360babc313a')

package() {

	install -d "${pkgdir}/usr/bin"

	install -Dm755 "tailwindcss-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/tailwindcss"
	install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
