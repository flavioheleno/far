pkgname=tailwindcss-bin
pkgver='4.3.5'
pkgrel='1'
pkgdesc='Standalone Tailwind CLI without dependency on Node.js'
arch=('aarch64' 'x86_64')
url='https://tailwindcss.com'
license=('MIT')
depends=('glibc')
options=('!strip')
conflicts=('tailwindcss')
provides=('tailwindcss')

_url_license='https://github.com/tailwindlabs/tailwindcss/raw/v4.3.5/LICENSE'
_url_aarch64='https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.5/tailwindcss-linux-arm64'
_url_x86_64='https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.5/tailwindcss-linux-x64'

source_aarch64=("tailwindcss-${pkgver}-aarch64::${_url_aarch64}")
source_x86_64=("tailwindcss-${pkgver}-x86_64::${_url_x86_64}")

source=("LICENSE-${pkgver}::${_url_license}")

sha256sums=('60e0b68c0f35c078eef3a5d29419d0b03ff84ec1df9c3f9d6e39a519a5ae7985')
sha256sums_aarch64=('ffcd0d21dbd7c605dc12743ff0c0b47debc963c86b399674084c1c8f2c96ecad')
sha256sums_x86_64=('e47695cee3f0d90623a91f3939b08bdee610eb5ad99340adff9d4145b284d6cc')

package() {

	install -d "${pkgdir}/usr/bin"

	install -Dm755 "tailwindcss-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/tailwindcss"
	install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
