pkgname=tableplus
pkgver='2.0.2.320'
pkgrel='1'
pkgdesc='Modern, native, and friendly GUI tool for relational databases (Alpha)'
arch=('x86_64' 'aarch64')
url='https://tableplus.com/'
license=('custom')
depends=('gtksourceview3' 'libgee' 'gnome-keyring')
_url_x86_64='https://deb.tableplus.com/debian/pool/main/t/tableplus/tableplus_2.0.2-320_amd64.deb'
_url_aarch64='https://deb.tableplus.com/debian/pool/main/t/tableplus/tableplus_2.0.2-320_arm64.deb'

source=('LICENSE' 'tableplus.desktop')
source_x86_64=("tableplus_${pkgver}_${pkgrel}_amd64.deb::${_url_x86_64}")
source_aarch64=("tableplus_${pkgver}_${pkgrel}_arm64.deb::${_url_aarch64}")
sha256sums=('76f924b1ebad5309ccf0dd7f3fe3d1b57ff3088b208a603900b0e240fdb5debb'
            '83620b08e325418947f0007ecca7b981a988bfdac3f466db165f9262d1c0e5f4')
sha256sums_x86_64=('5028e7be56606db756836fea1a7debb4ec77dd7cda7c3e191901c21dd14c94d2')
sha256sums_aarch64=('bcbf7135c597d37816b0bf4330975fcf986e975f4be7b3786f0b9c9a2ba30de3')
# FAR's updater verifies the vendor APT Release signature with this key; makepkg
# checks the .deb against the checksum taken from that signed metadata.
validpgpkeys=('211438D2880D8D98E100B1412A17818B38772786') # TablePlus (Release key) <nick@tableplus.com>

prepare() {
    tar -xf "${srcdir}/data.tar.zst"
}

package() {
    install -d "$pkgdir/opt/tableplus" "$pkgdir/usr/bin"
    install -Dm755 "$srcdir/opt/tableplus/tableplus" -t "$pkgdir/opt/tableplus/"
    install -Dm644 "$srcdir/opt/tableplus/tableplus.desktop" -t "$pkgdir/usr/share/applications/"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -r "$srcdir/opt/tableplus/resource" "$pkgdir/opt/tableplus/"
    ln -s /opt/tableplus/tableplus "$pkgdir/usr/bin/tableplus"
}
