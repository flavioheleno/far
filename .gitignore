# Local environment and Python tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.env
.env.*
!.env.example

# Arch build/download products (keep source patches and metadata tracked)
/packages/*/src/
/packages/*/pkg/
/packages/*/*.pkg.tar.*
/packages/*/*.src.tar.*
/packages/*/*.AppImage
/packages/*/*.deb
/packages/*/*.rpm
/packages/*/*.tar.*
/packages/*/squashfs-root/
/packages/*/*.log

# Local updater reports
/.far-updates/

# Work-environment mounts are not part of the project
/.agents/
/.aws/
/.codex/
